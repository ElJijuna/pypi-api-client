{
  "name": "pypi-api-client",
  "version": "0.0.1",
  "type": "module",
  "description": "TypeScript client for the PyPI REST API",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm test",
    "docs": "typedoc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "pypi",
    "pip",
    "python",
    "registry",
    "api-client",
    "rest",
    "typescript"
  ],
  "license": "MIT",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "homepage": "https://github.com/ElJijuna/pypi-api-client#readme",
  "bugs": {
    "url": "https://github.com/ElJijuna/pypi-api-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/pypi-api-client.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.3",
    "super-configs": "^1.11.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.3"
  }
}
